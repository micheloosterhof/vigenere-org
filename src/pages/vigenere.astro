import Base from "../layouts/Base.astro";
import CipherTool from "../components/CipherTool.astro";
import Breaker from "../components/Breaker.astro";
import Faq from "../components/Faq.astro";
---

<Base
  title="Vigenère cipher — encrypt and decrypt online"
  description="Encrypt and decrypt Vigenère cipher text online with any keyword. Runs in your browser."
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight">Vigenère cipher</h1>
  <p class="mb-8 max-w-prose text-slate-600 dark:text-slate-400">
    The Vigenère cipher shifts each letter of the text by the corresponding
    letter of a repeating keyword. Enter your text and a key, then choose
    encrypt or decrypt. Letters keep their case; spaces and punctuation are left
    unchanged.
  </p>
  <CipherTool cipher="vigenere" />

  <h2 class="mt-12 mb-4 text-2xl font-bold tracking-tight">
    Break without the key
  </h2>
  <p class="mb-6 max-w-prose text-slate-600 dark:text-slate-400">
    Paste Vigenère ciphertext with an unknown key and the solver recovers it by
    trying every key length and scoring candidate decryptions against English
    bigram statistics. It needs roughly four times as much text as the key is
    long.
  </p>
  <Breaker cipher="vigenere" />

  <h2 class="mt-12 mb-4 text-2xl font-bold tracking-tight">
    About the Vigenère cipher
  </h2>
  <div class="flex max-w-prose flex-col gap-4 text-slate-600 dark:text-slate-400">
    <p>
      The cipher was first described by Giovan Battista Bellaso in 1553 but was
      later misattributed to Blaise de Vigenère, whose name stuck. Each letter
      of the plaintext is shifted by the corresponding letter of a keyword that
      repeats for the whole message: with key LEMON, the plaintext ATTACKATDAWN
      becomes LXFOPVEFRNHR. Because the same plaintext letter can encrypt to
      many different ciphertext letters, simple frequency counting fails against
      it.
    </p>
    <p>
      For three centuries it was known as le chiffre indéchiffrable, the
      unbreakable cipher. Friedrich Kasiski published the first general attack
      in 1863: repeated words in the plaintext that happen to line up with the
      same part of the key produce repeated fragments in the ciphertext, and the
      distances between them reveal the key length. Once the key length is
      known, the message splits into ordinary Caesar ciphers, one per key
      letter.
    </p>
    <p>
      The solver on this page uses a stronger, modern method: it tries every key
      length, finds the most English-looking key for each by scoring letter-pair
      statistics, and reports the best result. It typically recovers the key
      from ciphertext only four times as long as the key itself.
    </p>
  </div>

  <Faq
    items={[
      {
        question: "How do I decrypt a Vigenère cipher without the key?",
        answer:
          "Paste the ciphertext into the breaker on this page. It tries every key length up to 30, picks the most English-like key for each length from letter-pair statistics, and polishes the best key with four-letter statistics. It needs roughly four letters of ciphertext per key letter.",
      },
      {
        question: "Who invented the Vigenère cipher?",
        answer:
          "Giovan Battista Bellaso described it in 1553. It was later misattributed to Blaise de Vigenère, who in 1586 published a stronger autokey cipher, and the name stuck.",
      },
      {
        question: "Is the Vigenère cipher secure?",
        answer:
          "No. Friedrich Kasiski published a general attack in 1863, and modern statistical solvers recover the key from a few hundred letters or fewer. It is suited to puzzles and teaching, not to protecting secrets.",
      },
      {
        question: "What is the difference between Vigenère and Beaufort?",
        answer:
          "Vigenère adds the key letter to the plaintext letter; Beaufort subtracts the plaintext letter from the key letter. Beaufort is therefore its own inverse, so one operation encrypts and decrypts, while Vigenère has separate encrypt and decrypt directions.",
      },
    ]}
  />
</Base>
