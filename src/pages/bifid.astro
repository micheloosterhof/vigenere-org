import Base from "../layouts/Base.astro";
import CipherTool from "../components/CipherTool.astro";
import Faq from "../components/Faq.astro";
---

<Base
  title="Bifid cipher — encrypt and decrypt online"
  description="Encrypt and decrypt the Bifid cipher online with a keyword-mixed 5x5 Polybius square and any period. Runs in your browser."
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight">Bifid cipher</h1>
  <p class="mb-8 max-w-prose text-slate-600 dark:text-slate-400">
    The Bifid cipher turns each letter into its row and column in a 5×5 square
    built from a keyword, with I and J sharing a cell. Within each block of
    letters (the period) it writes all the rows, then all the columns, and reads
    the digits back in pairs as letters. The output is uppercase letters only;
    spaces and punctuation are dropped.
  </p>
  <CipherTool cipher="bifid" />

  <h2 class="mt-12 mb-4 text-2xl font-bold tracking-tight">
    About the Bifid cipher
  </h2>
  <div class="flex max-w-prose flex-col gap-4 text-slate-600 dark:text-slate-400">
    <p>
      Félix Delastelle, a French amateur cryptographer, devised the Bifid cipher
      around the turn of the twentieth century. It combines a Polybius square
      with transposition, a technique called fractionation: each letter is split
      into two coordinates, the coordinates are shuffled across neighbouring
      letters, and the pieces are reassembled. As a result, each ciphertext
      letter depends on two different plaintext letters, so simple letter
      frequencies are flattened.
    </p>
    <p>
      The period controls how far the mixing reaches. With a period of 5,
      coordinates are shuffled only within blocks of five letters; a period of 0
      here treats the whole message as one block. Bifid is still breakable: with
      a known or guessed period, a hill climb over candidate squares, scored by
      English letter statistics, recovers the key from a few hundred letters.
      The American Cryptogram Association includes it among its standard cipher
      types.
    </p>
  </div>

  <Faq
    items={[
      {
        question: "How does the Bifid cipher work?",
        answer:
          "Each letter is replaced by its row and column in a keyword-mixed 5 × 5 square. Within each block of letters, all the rows are written out, followed by all the columns, and the digits are read back in pairs as letters.",
      },
      {
        question: "What is the period in the Bifid cipher?",
        answer:
          "The period is the block length over which coordinates are mixed. Sender and receiver must use the same period; a period of 0 on this page treats the whole message as one block.",
      },
      {
        question: "Why is Bifid harder to break than a simple substitution?",
        answer:
          "Each ciphertext letter combines coordinates from two different plaintext letters, so letter frequencies no longer map one to one. It is still breakable: with the period known, hill climbing over squares recovers the key from a few hundred letters.",
      },
    ]}
  />
</Base>
