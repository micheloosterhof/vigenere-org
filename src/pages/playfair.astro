import Base from "../layouts/Base.astro";
import CipherTool from "../components/CipherTool.astro";
import AnnealBreaker from "../components/AnnealBreaker.astro";
import Faq from "../components/Faq.astro";
---

<Base
  title="Playfair cipher — encrypt, decrypt, and break online"
  description="Encrypt, decrypt, and break the Playfair cipher online: a keyword-mixed 5x5 square, with a solver that recovers the square. Runs in your browser."
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight">Playfair cipher</h1>
  <p class="mb-8 max-w-prose text-slate-600 dark:text-slate-400">
    The Playfair cipher encrypts letters two at a time using a 5×5 square built
    from a keyword, with I and J sharing a cell. The output is a block of
    letters: spaces and punctuation are dropped, doubled letters are split with
    an X, and an odd-length message is padded.
  </p>
  <CipherTool cipher="playfair" />

  <h2 class="mt-12 mb-4 text-2xl font-bold tracking-tight">
    Break without the key
  </h2>
  <p class="mb-6 max-w-prose text-slate-600 dark:text-slate-400">
    Paste Playfair ciphertext and the solver searches for the square by
    simulated annealing, scoring each attempt by how English the decryption
    reads. Several searches run side by side on your processor cores and stop as
    soon as one reads as English. It needs about 125 letters and can take up to
    a minute; from 100 letters it often still works. The decryption keeps the X
    that split doubled letters. The solver on the home page runs the same search
    when a text has the marks of a Playfair: an even number of letters, no J,
    and no pair of equal letters.
  </p>
  <AnnealBreaker cipher="playfair" />

  <h2 class="mt-12 mb-4 text-2xl font-bold tracking-tight">
    About the Playfair cipher
  </h2>
  <div class="flex max-w-prose flex-col gap-4 text-slate-600 dark:text-slate-400">
    <p>
      Charles Wheatstone invented the cipher in 1854; it carries the name of
      Lord Playfair, who championed it to the British government. Encrypting
      digraphs instead of single letters was its innovation: with 600-odd
      digraph frequencies to tabulate instead of 26 letter frequencies, simple
      frequency analysis becomes much harder, yet the whole system fits on a 5×5
      grid two soldiers can share as a single memorable word. It served British
      forces in the Boer War and the First World War, and Australian
      coastwatchers in the Second.
    </p>
    <p>
      Its rules are mechanical. Letters in the same row of the square move one
      step right, letters in the same column move one step down, and any other
      pair forms a rectangle whose corners swap columns. Decryption reverses the
      shifts. The structure leaks, though: a digraph and its reverse encrypt to
      a pair and its reverse, and X-split doubles betray themselves. With a
      couple of hundred letters, Playfair falls to a search over candidate
      squares, as the solver on this page shows.
    </p>
  </div>

  <Faq
    items={[
      {
        question: "Why are I and J merged in the Playfair cipher?",
        answer:
          "The square has 5 × 5 = 25 cells, one short of the alphabet, so two letters share a cell. Merging J into I is the usual convention, because J is rare and reads naturally as I.",
      },
      {
        question: "Who invented the Playfair cipher?",
        answer:
          "Charles Wheatstone invented it in 1854. It carries the name of Lord Lyon Playfair, who promoted its use by the British government.",
      },
      {
        question: "Why does decrypted Playfair text contain extra X letters?",
        answer:
          "Before encrypting, doubled letters in the same pair are split with a filler (X, or Q when the letter is X) and an odd-length message is padded. Decryption returns those fillers; remove them by reading the text.",
      },
      {
        question: "How do I break a Playfair cipher without the key?",
        answer:
          "Paste the ciphertext into the solver on this page. It tries squares by simulated annealing, keeping the changes that make the decryption read more like English, and needs about 125 letters of ciphertext. The square it finds works as the key.",
      },
    ]}
  />
</Base>
