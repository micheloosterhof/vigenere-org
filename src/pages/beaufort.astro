import Base from "../layouts/Base.astro";
import CipherTool from "../components/CipherTool.astro";
---

<Base
  title="Beaufort cipher — encrypt and decrypt online"
  description="Encrypt and decrypt Beaufort cipher text online with any keyword. Runs in your browser."
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight">Beaufort cipher</h1>
  <p class="mb-8 max-w-prose text-slate-600 dark:text-slate-400">
    The Beaufort cipher subtracts each text letter from the corresponding letter
    of a repeating keyword. It is reciprocal: encrypting twice with the same key
    returns the original text, so a single operation handles both directions.
  </p>
  <CipherTool cipher="beaufort" />
</Base>
