---
// ABOUTME: Encrypt/decrypt form for the autokey cipher with variant and tableau selection.
// ABOUTME: The variant picks what extends the key; the tableau picks how key and letter combine.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause
import { buttonClass, fieldClass } from "../styles/form";
import ShareLink from "./ShareLink.astro";
import WordSplitToggle from "./WordSplitToggle.astro";
---

<div data-autokey class="flex flex-col gap-4">
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Variant</span>
    <select data-variant class={`${fieldClass} max-w-88`}>
      <option value="plaintext" selected>
        Plaintext autokey — the message extends the key
      </option>
      <option value="ciphertext">
        Ciphertext autokey — the ciphertext extends the key
      </option>
    </select>
  </label>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Tableau</span>
    <select data-tableau class={`${fieldClass} max-w-88`}>
      <option value="vigenere" selected>
        Vigenère — C = P + K
      </option>
      <option value="beaufort">Beaufort — C = K − P</option>
      <option value="variant-beaufort">Variant Beaufort — C = P − K</option>
    </select>
  </label>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Text</span>
    <textarea
      data-input
      rows="6"
      class={fieldClass}
      placeholder="Enter plaintext or ciphertext"
    ></textarea>
  </label>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Primer</span>
    <input
      data-key
      type="text"
      class={fieldClass}
      placeholder="e.g. TYPEWRITER"
    />
  </label>

  <div class="flex gap-3">
    <button data-encrypt type="button" class={buttonClass}>
      Encrypt
    </button>
    <button data-decrypt type="button" class={buttonClass}>
      Decrypt
    </button>
    <ShareLink />
  </div>

  <p
    data-error
    hidden
    role="alert"
    class="text-sm text-red-600 dark:text-red-400"
  ></p>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Result</span>
    <textarea data-output rows="6" readonly class={fieldClass}></textarea>
  </label>
  <WordSplitToggle />
</div>

<script>
  import {
    autokey,
    type AutokeyTableau,
    type AutokeyVariant,
    type Mode,
  } from "../lib/cipher";
  import { deepLink, liveShareUrl } from "./live-url";
  import { liveRegion } from "./announce";
  import { wordSplitOutput } from "./word-split";

  for (const root of document.querySelectorAll<HTMLElement>("[data-autokey]")) {
    const variant = root.querySelector<HTMLSelectElement>("[data-variant]");
    const tableau = root.querySelector<HTMLSelectElement>("[data-tableau]");
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const key = root.querySelector<HTMLInputElement>("[data-key]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    if (!variant || !tableau || !input || !key || !output || !error) {
      continue;
    }
    const setOutput = wordSplitOutput(root, output);
    const announce = liveRegion(root);

    let lastMode: Mode = "encrypt";
    const syncUrl = liveShareUrl(() =>
      input.value === ""
        ? null
        : [
            ["text", input.value],
            ["key", key.value],
            ["variant", variant.value],
            ["tableau", tableau.value === "vigenere" ? "" : tableau.value],
            ["mode", lastMode === "decrypt" ? "decrypt" : ""],
          ],
    );
    input.addEventListener("input", syncUrl);
    key.addEventListener("input", syncUrl);
    variant.addEventListener("change", syncUrl);
    tableau.addEventListener("change", syncUrl);

    const run = (mode: Mode): void => {
      lastMode = mode;
      syncUrl();
      error.hidden = true;
      try {
        const result = autokey(
          input.value,
          key.value,
          variant.value as AutokeyVariant,
          tableau.value as AutokeyTableau,
          mode,
        );
        setOutput(result);
        announce(`Result: ${result}`);
      } catch (cause) {
        setOutput("");
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
      }
    };

    root
      .querySelector("[data-encrypt]")
      ?.addEventListener("click", () => run("encrypt"));
    root
      .querySelector("[data-decrypt]")
      ?.addEventListener("click", () => run("decrypt"));

    // Deep link: /autokey?text=...&key=X&variant=ciphertext&tableau=beaufort&mode=encrypt
    const params = deepLink("tool");
    if (params) {
      input.value = params.get("text") ?? "";
      const keyValue = params.get("key");
      if (keyValue !== null) {
        key.value = keyValue;
      }
      const variantValue = params.get("variant");
      if (variantValue === "plaintext" || variantValue === "ciphertext") {
        variant.value = variantValue;
      }
      const tableauValue = params.get("tableau");
      if (tableauValue === "beaufort" || tableauValue === "variant-beaufort") {
        tableau.value = tableauValue;
      }
      run(params.get("mode") === "decrypt" ? "decrypt" : "encrypt");
    }
  }
</script>
