---
// ABOUTME: Key-recovery form: finds the key for ciphertext without knowing it.
// ABOUTME: Periodic ciphers recover a keyword; Caesar, affine, rail fence, and route rank every key.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause

interface Props {
  cipher:
    | "vigenere"
    | "beaufort"
    | "gronsfeld"
    | "porta"
    | "caesar"
    | "affine"
    | "substitution"
    | "railfence"
    | "columnar"
    | "route";
}

import { buttonClass, fieldClass } from "../styles/form";
import ShareLink from "./ShareLink.astro";
import WordSplitToggle from "./WordSplitToggle.astro";

const { cipher } = Astro.props;

const SOLVE_LABEL: Partial<Record<Props["cipher"], string>> = {
  caesar: "Try all 26 shifts",
  affine: "Try all 312 keys",
  substitution: "Recover alphabet",
  railfence: "Find rail count",
  columnar: "Recover column order",
  route: "Find grid and route",
};
const KEY_HEADING: Partial<Record<Props["cipher"], string>> = {
  caesar: "Shift",
  railfence: "Rails",
  route: "Grid and route",
};
---

<div data-breaker={cipher} class="flex flex-col gap-4">
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Ciphertext</span>
    <textarea
      data-input
      rows="6"
      class={fieldClass}
      placeholder="Paste ciphertext with an unknown key"
    ></textarea>
  </label>

  <div class="flex items-center gap-3">
    <button data-solve type="button" class={buttonClass}>
      {SOLVE_LABEL[cipher] ?? "Recover key"}
    </button>
    <ShareLink />
  </div>

  <p
    data-error
    hidden
    role="alert"
    class="text-sm text-red-600 dark:text-red-400"
  ></p>

  <div data-result hidden class="flex flex-col gap-4">
    <p data-summary class="text-sm font-medium"></p>
    <label class="flex flex-col gap-1">
      <span class="text-sm font-medium">Decrypted text</span>
      <textarea data-output rows="6" readonly class={fieldClass}></textarea>
    </label>
    <WordSplitToggle />
    <div>
      <span class="text-sm font-medium">Other candidates</span>
      <div class="overflow-x-auto">
        <table class="mt-1 w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-300 dark:border-slate-700">
              <th class="py-1 pr-4 font-medium">
                {KEY_HEADING[cipher] ?? "Key"}
              </th>
              <th class="py-1 pr-4 font-medium">Fitness</th>
              <th class="py-1 font-medium">Preview</th>
            </tr>
          </thead>
          <tbody data-candidates class="font-mono"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    beaufort,
    caesar,
    gronsfeld,
    porta,
    substitution,
    vigenere,
  } from "../lib/cipher";
  import {
    beaufortDecrypt,
    breakPeriodic,
    caesarCandidates,
    breakPorta,
    vigenereDecrypt,
  } from "../lib/solve";
  import { breakAffine } from "../lib/affine";
  import { breakRoute, FILLS, ROUTES } from "../lib/route";
  import { breakSubstitution } from "../lib/solve-substitution";
  import { breakRailFence } from "../lib/railfence";
  import { breakColumnar } from "../lib/transposition";
  import { loadQuadgramTable } from "../lib/quadgrams";
  import { liveRegion } from "./announce";
  import { breakerShareUrl } from "./live-url";
  import { wordSplitOutput } from "./word-split";

  const CANDIDATE_ROWS = 5;
  const PREVIEW_LENGTH = 40;

  interface Ranked {
    label: string;
    fitness: number;
    plaintext: string;
    summary: string;
  }

  async function rank(cipher: string, text: string): Promise<Ranked[]> {
    if (cipher === "substitution") {
      const result = breakSubstitution(text, await loadQuadgramTable());
      return [
        {
          label: result.key,
          fitness: result.fitness,
          plaintext: substitution(text, result.key, "decrypt"),
          summary: `Recovered alphabet: ${result.key}`,
        },
      ];
    }
    if (cipher === "columnar") {
      return breakColumnar(text).map((candidate) => ({
        label: candidate.key,
        fitness: candidate.fitness,
        plaintext: candidate.plaintext,
        summary: `Recovered column order: ${candidate.key} (length ${candidate.keyLength})`,
      }));
    }
    if (cipher === "railfence") {
      return breakRailFence(text).map((candidate) => ({
        label: String(candidate.rails),
        fitness: candidate.fitness,
        plaintext: candidate.plaintext,
        summary: `Best rail count: ${candidate.rails}`,
      }));
    }
    if (cipher === "affine") {
      return breakAffine(text).map((candidate) => ({
        label: `a=${candidate.a}, b=${candidate.b}`,
        fitness: candidate.fitness,
        plaintext: candidate.plaintext,
        summary: `Best key: a = ${candidate.a}, b = ${candidate.b}`,
      }));
    }
    if (cipher === "route") {
      return breakRoute(text).map((candidate) => {
        const setting = `${candidate.columns} columns, ${FILLS[candidate.fill].toLowerCase()}, ${ROUTES[candidate.route].toLowerCase()}`;
        return {
          label: setting,
          fitness: candidate.fitness,
          plaintext: candidate.plaintext,
          summary: `Best grid and route: ${setting}`,
        };
      });
    }
    if (cipher === "caesar") {
      return caesarCandidates(text).map((candidate) => ({
        label: String(candidate.shift),
        fitness: candidate.fitness,
        plaintext: caesar(text, -candidate.shift),
        summary: `Best shift: ${candidate.shift}`,
      }));
    }
    const periodic = { quadgrams: await loadQuadgramTable() };
    if (cipher === "beaufort") {
      return breakPeriodic(text, beaufortDecrypt, periodic).map(
        (candidate) => ({
          label: candidate.key,
          fitness: candidate.fitness,
          plaintext: beaufort(text, candidate.key),
          summary: `Recovered key: ${candidate.key} (length ${candidate.keyLength})`,
        }),
      );
    }
    if (cipher === "porta") {
      return breakPorta(text, periodic).map((candidate) => ({
        label: candidate.key,
        fitness: candidate.fitness,
        plaintext: porta(text, candidate.key),
        summary: `Recovered key: ${candidate.key} (length ${candidate.keyLength}). Porta pairs key letters (AB, CD, …), so each letter could equally be its partner.`,
      }));
    }
    if (cipher === "gronsfeld") {
      return breakPeriodic(text, vigenereDecrypt, {
        ...periodic,
        keySpace: 10,
      }).map((candidate) => {
        const digits = [...candidate.key]
          .map((letter) => letter.charCodeAt(0) - 65)
          .join("");
        return {
          label: digits,
          fitness: candidate.fitness,
          plaintext: gronsfeld(text, digits, "decrypt"),
          summary: `Recovered key: ${digits} (length ${candidate.keyLength})`,
        };
      });
    }
    return breakPeriodic(text, vigenereDecrypt, periodic).map((candidate) => ({
      label: candidate.key,
      fitness: candidate.fitness,
      plaintext: vigenere(text, candidate.key, "decrypt"),
      summary: `Recovered key: ${candidate.key} (length ${candidate.keyLength})`,
    }));
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-breaker]")) {
    const cipher = root.dataset.breaker;
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    const result = root.querySelector<HTMLElement>("[data-result]");
    const summary = root.querySelector<HTMLParagraphElement>("[data-summary]");
    const candidates =
      root.querySelector<HTMLTableSectionElement>("[data-candidates]");
    const solve = root.querySelector<HTMLButtonElement>("[data-solve]");
    if (
      !cipher ||
      !input ||
      !output ||
      !error ||
      !result ||
      !summary ||
      !candidates ||
      !solve
    ) {
      continue;
    }
    const setOutput = wordSplitOutput(root, output);
    const announce = liveRegion(root);

    solve.addEventListener("click", async () => {
      error.hidden = true;
      result.hidden = true;
      candidates.replaceChildren();
      solve.disabled = true;
      try {
        const ranked = await rank(cipher, input.value);
        const best = ranked[0];
        summary.textContent = best.summary;
        setOutput(best.plaintext);
        announce(`${best.summary}. ${best.plaintext}`);
        for (const candidate of ranked.slice(1, 1 + CANDIDATE_ROWS)) {
          const row = document.createElement("tr");
          for (const text of [
            candidate.label,
            candidate.fitness.toFixed(3),
            candidate.plaintext.slice(0, PREVIEW_LENGTH),
          ]) {
            const cell = document.createElement("td");
            cell.textContent = text;
            cell.className = "py-1 pr-4 align-top";
            row.append(cell);
          }
          candidates.append(row);
        }
        result.hidden = false;
      } catch (cause) {
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
      } finally {
        solve.disabled = false;
      }
    });

    // Deep link: /vigenere?text=...&mode=break
    breakerShareUrl(input, solve);
  }
</script>
