---
// ABOUTME: Cipher analysis panel: shows statistical diagnostics and a likely cipher family.
// ABOUTME: Runs the diagnostics synchronously in the browser; nothing is sent to a server.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause
import { buttonClass, fieldClass } from "../styles/form";
---

<div data-analyzer class="flex flex-col gap-4">
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Ciphertext</span>
    <textarea
      data-input
      rows="6"
      class={fieldClass}
      placeholder="Paste text to analyze"></textarea>
  </label>

  <div>
    <button data-analyze type="button" class={buttonClass}>Analyze</button>
  </div>

  <p data-error hidden class="text-sm text-red-600 dark:text-red-400"></p>

  <div data-result hidden class="flex flex-col gap-4">
    <p data-summary class="text-base font-medium"></p>
    <div>
      <span class="text-sm font-medium">Letter frequencies</span>
      <svg
        data-chart
        viewBox="0 0 580 190"
        role="img"
        aria-label="Letter frequency bar chart of the analyzed text compared with typical English"
        class="mt-1 w-full max-w-xl"></svg>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Bars: this text. Marks: typical English.
      </p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-300 dark:border-slate-700">
            <th class="py-1 pr-4 font-medium">Measure</th>
            <th class="py-1 pr-4 font-medium">Value</th>
            <th class="py-1 font-medium">What it tells you</th>
          </tr>
        </thead>
        <tbody data-rows class="align-top"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import {
    analyze,
    ENGLISH_FREQUENCIES,
    type CipherFamily,
  } from "../lib/diagnostics";
  import { toLetterValues } from "../lib/solve";
  import { liveShareUrl } from "./live-url";

  const SVG_NS = "http://www.w3.org/2000/svg";

  /** Draws bars for the text's letter frequencies with marks at English levels. */
  function drawChart(chart: SVGSVGElement, values: number[]): void {
    chart.replaceChildren();
    const counts = new Array<number>(26).fill(0);
    for (const value of values) {
      counts[value] += 1;
    }
    const freqs = counts.map((count) => count / values.length);
    const peak = Math.max(...freqs, ...ENGLISH_FREQUENCIES);
    const slot = 22;
    const barWidth = 14;
    const height = 160;
    const baseline = 168;
    for (let letter = 0; letter < 26; letter += 1) {
      const x = letter * slot + 4;
      const barHeight = (freqs[letter] / peak) * height;
      const bar = document.createElementNS(SVG_NS, "rect");
      bar.setAttribute("x", String(x));
      bar.setAttribute("y", String(baseline - barHeight));
      bar.setAttribute("width", String(barWidth));
      bar.setAttribute("height", String(barHeight));
      bar.setAttribute("class", "fill-orange-500 dark:fill-orange-400");
      chart.append(bar);
      const mark = document.createElementNS(SVG_NS, "line");
      const y = baseline - (ENGLISH_FREQUENCIES[letter] / peak) * height;
      mark.setAttribute("x1", String(x - 2));
      mark.setAttribute("x2", String(x + barWidth + 2));
      mark.setAttribute("y1", String(y));
      mark.setAttribute("y2", String(y));
      mark.setAttribute("stroke-width", "2");
      mark.setAttribute("class", "stroke-slate-500 dark:stroke-slate-400");
      chart.append(mark);
      const label = document.createElementNS(SVG_NS, "text");
      label.textContent = String.fromCharCode(65 + letter);
      label.setAttribute("x", String(x + barWidth / 2));
      label.setAttribute("y", "184");
      label.setAttribute("text-anchor", "middle");
      label.setAttribute(
        "class",
        "fill-slate-600 text-[11px] dark:fill-slate-400",
      );
      chart.append(label);
    }
  }

  const FAMILY_TEXT: Record<CipherFamily, string> = {
    monoalphabetic:
      "The letters keep an English-like frequency profile, so this looks monoalphabetic — a Caesar or substitution cipher.",
    periodic:
      "The letter frequencies are flattened but sharpen when split into columns, the signature of a repeating-key cipher: Vigenère, Beaufort, or Quagmire.",
    transposition:
      "The letters keep exactly English frequencies but the text does not read, so they were moved rather than disguised: a transposition cipher such as rail fence or columnar.",
    "ciphertext-autokey":
      "A difference of the ciphertext reads as English, the signature of a ciphertext autokey cipher.",
    unknown:
      "The statistics do not match a common pattern. It may be a plaintext autokey, a longer polyalphabetic key, or not a simple cipher at all.",
  };

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-analyzer]",
  )) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const analyzeButton =
      root.querySelector<HTMLButtonElement>("[data-analyze]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    const result = root.querySelector<HTMLElement>("[data-result]");
    const summary = root.querySelector<HTMLParagraphElement>("[data-summary]");
    const rows = root.querySelector<HTMLTableSectionElement>("[data-rows]");
    const chart = root.querySelector<SVGSVGElement>("[data-chart]");
    if (
      !input ||
      !analyzeButton ||
      !error ||
      !result ||
      !summary ||
      !rows ||
      !chart
    ) {
      continue;
    }

    analyzeButton.addEventListener("click", () => {
      error.hidden = true;
      result.hidden = true;
      rows.replaceChildren();
      try {
        const d = analyze(input.value);
        summary.textContent = FAMILY_TEXT[d.likelyFamily];
        drawChart(chart, toLetterValues(input.value));
        const entries: [string, string, string][] = [
          ["Letters", String(d.length), "Length of the analyzed text."],
          [
            "Index of coincidence",
            d.ioc.toFixed(3),
            "About 1.73 for English, 1.0 for random. High means monoalphabetic.",
          ],
          [
            "Digraph IoC",
            d.digraphIoc.toFixed(3),
            "Coincidence of letter pairs.",
          ],
          [
            "Entropy (bits)",
            d.entropy.toFixed(3),
            "Higher is closer to uniform random.",
          ],
          [
            "English frequency fit",
            d.chiSquaredEnglish.toFixed(2),
            "Chi-squared per letter against English frequencies; below ~1 the letters themselves are English.",
          ],
          [
            "Bigram fitness",
            d.bigramFitness.toFixed(2),
            "Average bigram log probability as the text stands; English reads above about -2.55.",
          ],
          [
            "Key length",
            d.period === 1 ? "1 (none)" : String(d.period),
            "Period suggested by per-column coincidence.",
          ],
          [
            "Coincidence rate",
            d.kappaAtPeriod.toFixed(4),
            "Kappa at the key length; rises above ~0.038 when the text is periodic or English.",
          ],
          [
            "Autokey delta IoC",
            `${d.autokeyDeltaIoc.toFixed(3)} at lag ${d.autokeyLag}`,
            "High means ciphertext autokey; the lag is the primer length.",
          ],
        ];
        for (const [measure, value, meaning] of entries) {
          const row = document.createElement("tr");
          const cells = [measure, value, meaning];
          cells.forEach((text, i) => {
            const cell = document.createElement("td");
            cell.textContent = text;
            cell.className = i === 1 ? "py-1 pr-4 font-mono" : "py-1 pr-4";
            row.append(cell);
          });
          rows.append(row);
        }
        result.hidden = false;
      } catch (cause) {
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
      }
    });

    const syncUrl = liveShareUrl(() =>
      input.value === "" ? null : [["text", input.value]],
    );
    input.addEventListener("input", syncUrl);

    // Deep link: /analyze?text=...
    const text = new URLSearchParams(location.search).get("text");
    if (text !== null) {
      input.value = text;
      analyzeButton.click();
    }
  }
</script>
