---
// ABOUTME: Form for the general polyalphabetic solver; runs the attack in a Web Worker.
// ABOUTME: Shows restart progress, the recovered period, per-column alphabets, and the decryption.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause
import { buttonClass, fieldClass } from "../styles/form";
---

<div data-poly class="flex flex-col gap-4">
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Ciphertext</span>
    <textarea
      data-input
      rows="8"
      class={fieldClass}
      placeholder="Paste periodic polyalphabetic ciphertext"></textarea>
  </label>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Key length (leave empty to detect)</span>
    <input
      data-period
      type="number"
      min="1"
      max="12"
      class={`${fieldClass} max-w-32`}
    />
  </label>

  <div class="flex items-center gap-4">
    <button data-solve type="button" class={buttonClass}>Break cipher</button>
    <span
      data-progress
      hidden
      class="text-sm text-slate-500 dark:text-slate-400"></span>
  </div>

  <p data-error hidden class="text-sm text-red-600 dark:text-red-400"></p>

  <div data-result hidden class="flex flex-col gap-4">
    <p data-summary class="text-sm font-medium"></p>
    <label class="flex flex-col gap-1">
      <span class="text-sm font-medium">Decrypted text</span>
      <textarea data-output rows="8" readonly class={fieldClass}></textarea>
    </label>
    <div>
      <span class="text-sm font-medium"
        >Recovered alphabets (one per key position)</span
      >
      <pre data-alphabets class="mt-1 overflow-x-auto font-mono text-sm"></pre>
    </div>
  </div>
</div>

<script>
  import { loadQuadgramTable } from "../lib/quadgrams";
  import type {
    PolyalphabeticProgress,
    PolyalphabeticResult,
  } from "../lib/solve-polyalphabetic";

  type WorkerMessage =
    | ({ type: "progress" } & PolyalphabeticProgress)
    | { type: "result"; result: PolyalphabeticResult }
    | { type: "error"; message: string };

  for (const root of document.querySelectorAll<HTMLElement>("[data-poly]")) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const periodInput = root.querySelector<HTMLInputElement>("[data-period]");
    const solve = root.querySelector<HTMLButtonElement>("[data-solve]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    const result = root.querySelector<HTMLElement>("[data-result]");
    const summary = root.querySelector<HTMLParagraphElement>("[data-summary]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const alphabets = root.querySelector<HTMLPreElement>("[data-alphabets]");
    if (
      !input ||
      !periodInput ||
      !solve ||
      !progress ||
      !error ||
      !result ||
      !summary ||
      !output ||
      !alphabets
    ) {
      continue;
    }

    const finish = (): void => {
      solve.disabled = false;
      progress.hidden = true;
    };

    solve.addEventListener("click", async () => {
      error.hidden = true;
      result.hidden = true;
      solve.disabled = true;
      progress.textContent = "Loading language data…";
      progress.hidden = false;
      try {
        const table = await loadQuadgramTable();
        const period = Number.parseInt(periodInput.value, 10);
        const worker = new Worker(
          new URL("../lib/polyalphabetic.worker.ts", import.meta.url),
          { type: "module" },
        );
        worker.onmessage = (event: MessageEvent<WorkerMessage>) => {
          const message = event.data;
          if (message.type === "progress") {
            progress.textContent = `Solving… attempt ${message.restart} of ${message.restarts}, fitness ${message.fitness.toFixed(2)}`;
          } else if (message.type === "result") {
            worker.terminate();
            const solved = message.result;
            summary.textContent = `Key length ${solved.period}, fitness ${solved.fitness.toFixed(2)}. Rare letters may be wrong; the alphabets below can be corrected by hand.`;
            output.value = solved.plaintext;
            alphabets.textContent = solved.alphabets
              .map((alphabet, i) => `${String(i + 1).padStart(2)}: ${alphabet}`)
              .join("\n");
            result.hidden = false;
            finish();
          } else {
            worker.terminate();
            error.textContent = message.message;
            error.hidden = false;
            finish();
          }
        };
        worker.postMessage({
          text: input.value,
          table: table.buffer,
          period: Number.isNaN(period) ? undefined : period,
        });
        progress.textContent = "Solving…";
      } catch (cause) {
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
        finish();
      }
    });
  }
</script>
