---
// ABOUTME: Interactive encrypt/decrypt form shared by all cipher tool pages.
// ABOUTME: The cipher prop selects which cipher the client-side script applies.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause

interface Props {
  cipher:
    | "vigenere"
    | "beaufort"
    | "caesar"
    | "substitution"
    | "atbash"
    | "rot13"
    | "railfence"
    | "columnar"
    | "playfair";
}

import { buttonClass, fieldClass } from "../styles/form";

const { cipher } = Astro.props;
const usesShift = cipher === "caesar";
const usesRails = cipher === "railfence";
const keyless = cipher === "atbash" || cipher === "rot13";
const reciprocal = cipher === "beaufort" || keyless;
const keyLabel = usesShift ? "Shift" : usesRails ? "Rails" : "Key";
---

<div data-cipher={cipher} class="flex flex-col gap-4">
  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Text</span>
    <textarea
      data-input
      rows="6"
      class={fieldClass}
      placeholder="Enter plaintext or ciphertext"></textarea>
  </label>

  {
    !keyless && (
      <label class="flex flex-col gap-1">
        <span class="text-sm font-medium">{keyLabel}</span>
        {usesShift || usesRails ? (
          <input
            data-key
            type="number"
            min={usesRails ? "1" : "0"}
            max={usesRails ? "20" : "25"}
            value="3"
            class={`${fieldClass} max-w-32`}
          />
        ) : (
          <input
            data-key
            type="text"
            class={fieldClass}
            placeholder="Enter key"
          />
        )}
      </label>
    )
  }

  <div class="flex gap-3">
    {
      reciprocal ? (
        <button data-encrypt type="button" class={buttonClass}>
          Encrypt / decrypt
        </button>
      ) : (
        <>
          <button data-encrypt type="button" class={buttonClass}>
            Encrypt
          </button>
          <button data-decrypt type="button" class={buttonClass}>
            Decrypt
          </button>
        </>
      )
    }
  </div>

  <p data-error hidden class="text-sm text-red-600 dark:text-red-400"></p>

  <label class="flex flex-col gap-1">
    <span class="text-sm font-medium">Result</span>
    <textarea data-output rows="6" readonly class={fieldClass}></textarea>
  </label>
</div>

<script>
  import {
    atbash,
    beaufort,
    caesar,
    substitution,
    vigenere,
    type Mode,
  } from "../lib/cipher";
  import { railFence } from "../lib/railfence";
  import { columnarTransposition } from "../lib/transposition";
  import { playfair } from "../lib/playfair";

  for (const root of document.querySelectorAll<HTMLElement>("[data-cipher]")) {
    const cipher = root.dataset.cipher;
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const key = root.querySelector<HTMLInputElement>("[data-key]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    if (!cipher || !input || !output || !error) {
      continue;
    }

    const keyValue = (): string => key?.value ?? "";

    const apply = (text: string, mode: Mode): string => {
      switch (cipher) {
        case "atbash":
          return atbash(text);
        case "rot13":
          return caesar(text, 13);
        case "beaufort":
          return beaufort(text, keyValue());
        case "substitution":
          return substitution(text, keyValue(), mode);
        case "caesar": {
          const shift = Number.parseInt(keyValue(), 10);
          if (Number.isNaN(shift)) {
            throw new Error("shift must be a number between 0 and 25");
          }
          return caesar(text, mode === "encrypt" ? shift : -shift);
        }
        case "columnar":
          return columnarTransposition(text, keyValue(), mode);
        case "playfair":
          return playfair(text, keyValue(), mode);
        case "railfence": {
          const rails = Number.parseInt(keyValue(), 10);
          if (Number.isNaN(rails)) {
            throw new Error("rails must be a number between 1 and 20");
          }
          return railFence(text, rails, mode);
        }
        default:
          return vigenere(text, keyValue(), mode);
      }
    };

    const run = (mode: Mode): void => {
      error.hidden = true;
      try {
        output.value = apply(input.value, mode);
      } catch (cause) {
        output.value = "";
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
      }
    };

    root
      .querySelector("[data-encrypt]")
      ?.addEventListener("click", () => run("encrypt"));
    root
      .querySelector("[data-decrypt]")
      ?.addEventListener("click", () => run("decrypt"));

    // Deep link: /caesar?text=Khoor&shift=3&mode=decrypt (rails for rail fence, key for the rest)
    const params = new URLSearchParams(location.search);
    const text = params.get("text");
    if (text !== null) {
      input.value = text;
      const linkedKey =
        cipher === "caesar"
          ? params.get("shift")
          : cipher === "railfence"
            ? params.get("rails")
            : params.get("key");
      if (key && linkedKey !== null) {
        key.value = linkedKey;
      }
      run(params.get("mode") === "decrypt" ? "decrypt" : "encrypt");
    }
  }
</script>
