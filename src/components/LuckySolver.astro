---
// ABOUTME: Homepage auto-solver: one big box that identifies and breaks the cipher.
// ABOUTME: Routes by letter statistics in a Web Worker, escalating to heavier attacks as needed.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause
import { buttonClass, fieldClass } from "../styles/form";
---

<div data-lucky class="flex flex-col gap-4">
  <textarea
    data-input
    rows="8"
    class={`${fieldClass} text-base shadow-sm`}
    placeholder="Paste your encrypted message here"></textarea>

  <div class="flex items-center justify-center gap-4">
    <button
      data-solve
      type="button"
      class={`${buttonClass} px-6 py-3 text-base`}
    >
      I'm feeling lucky
    </button>
    <span
      data-progress
      hidden
      class="text-sm text-slate-500 dark:text-slate-400"></span>
  </div>

  <p
    data-error
    hidden
    class="text-center text-sm text-red-600 dark:text-red-400"
  >
  </p>

  <div data-result hidden class="flex flex-col gap-4 text-left">
    <p data-summary class="text-sm font-medium"></p>
    <label class="flex flex-col gap-1">
      <span class="text-sm font-medium">Decrypted text</span>
      <textarea data-output rows="6" readonly class={fieldClass}></textarea>
    </label>
    <div>
      <span class="text-sm font-medium">All attempts</span>
      <div class="overflow-x-auto">
        <table class="mt-1 w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-300 dark:border-slate-700">
              <th class="py-1 pr-4 font-medium">Cipher</th>
              <th class="py-1 pr-4 font-medium">Key</th>
              <th class="py-1 pr-4 font-medium">Fitness</th>
              <th class="py-1 font-medium">Preview</th>
            </tr>
          </thead>
          <tbody data-attempts></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { loadQuadgramTable } from "../lib/quadgrams";
  import type { AutosolveResult } from "../lib/autosolve";
  import type { PolyalphabeticProgress } from "../lib/solve-polyalphabetic";

  type WorkerMessage =
    | ({ type: "progress" } & PolyalphabeticProgress)
    | { type: "result"; result: AutosolveResult }
    | { type: "error"; message: string };

  const PREVIEW_LENGTH = 40;

  function summarize(result: AutosolveResult): string {
    const route =
      result.period === 1
        ? "Letter statistics look monoalphabetic."
        : `Letter statistics suggest a repeating key of length ${result.period}.`;
    if (result.alreadyEnglish) {
      return "This already looks like readable English, but here is the best decryption anyway.";
    }
    return `${route} This looks like the ${result.best.cipher} cipher (${result.best.keyLabel}).`;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-lucky]")) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]");
    const solve = root.querySelector<HTMLButtonElement>("[data-solve]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const error = root.querySelector<HTMLParagraphElement>("[data-error]");
    const result = root.querySelector<HTMLElement>("[data-result]");
    const summary = root.querySelector<HTMLParagraphElement>("[data-summary]");
    const table =
      root.querySelector<HTMLTableSectionElement>("[data-attempts]");
    if (
      !input ||
      !solve ||
      !progress ||
      !output ||
      !error ||
      !result ||
      !summary ||
      !table
    ) {
      continue;
    }

    const finish = (): void => {
      solve.disabled = false;
      progress.hidden = true;
    };

    solve.addEventListener("click", async () => {
      error.hidden = true;
      result.hidden = true;
      table.replaceChildren();
      solve.disabled = true;
      progress.textContent = "Loading language data…";
      progress.hidden = false;
      try {
        const quadgrams = await loadQuadgramTable();
        const worker = new Worker(
          new URL("../lib/autosolve.worker.ts", import.meta.url),
          {
            type: "module",
          },
        );
        worker.onmessage = (event: MessageEvent<WorkerMessage>) => {
          const message = event.data;
          if (message.type === "progress") {
            progress.textContent = `Trying harder ciphers… attempt ${message.restart} of ${message.restarts}`;
          } else if (message.type === "result") {
            worker.terminate();
            const solved = message.result;
            summary.textContent = summarize(solved);
            output.value = solved.best.plaintext;
            for (const attempt of solved.attempts) {
              const row = document.createElement("tr");
              const cipherCell = document.createElement("td");
              const link = document.createElement("a");
              link.href = attempt.href;
              link.textContent = attempt.cipher;
              link.className =
                "font-medium text-orange-700 underline-offset-2 hover:underline dark:text-orange-400";
              cipherCell.append(link);
              cipherCell.className = "py-1 pr-4 align-top";
              row.append(cipherCell);
              for (const text of [
                attempt.keyLabel,
                attempt.fitness.toFixed(3),
                attempt.plaintext.slice(0, PREVIEW_LENGTH),
              ]) {
                const cell = document.createElement("td");
                cell.textContent = text;
                cell.className = "py-1 pr-4 align-top font-mono";
                row.append(cell);
              }
              table.append(row);
            }
            result.hidden = false;
            finish();
          } else {
            worker.terminate();
            error.textContent = message.message;
            error.hidden = false;
            finish();
          }
        };
        worker.postMessage({ text: input.value, table: quadgrams.buffer });
        progress.textContent = "Solving…";
      } catch (cause) {
        error.textContent =
          cause instanceof Error ? cause.message : String(cause);
        error.hidden = false;
        finish();
      }
    });
  }
</script>
