---
// ABOUTME: Base page layout: head metadata, site navigation, and footer.
// ABOUTME: Every page on the site wraps its content in this layout.
// SPDX-FileCopyrightText: 2026 Michel Oosterhof
// SPDX-License-Identifier: BSD-3-Clause
import "../styles/global.css";
import ClipboardButtons from "../components/ClipboardButtons.astro";

interface Props {
  title: string;
  description: string;
  /** Google policy forbids ads on error, legal, and other non-content pages. */
  ads?: boolean;
}

const { title, description, ads = true } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as
  string | undefined;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as
  string | undefined;
const homeUrl = new URL("/", Astro.site).href;
const jsonLdBlocks: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: title,
    url: canonical.href,
    description,
    applicationCategory: "UtilityApplication",
    operatingSystem: "Any",
    isAccessibleForFree: true,
  },
];
if (Astro.url.pathname === "/") {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "vigenere.org",
    url: homeUrl,
  });
} else {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      { "@type": "ListItem", position: 2, name: title.split(" — ")[0] },
    ],
  });
}

const tools = [
  { href: "/vigenere", label: "Vigenère" },
  { href: "/beaufort", label: "Beaufort" },
  { href: "/caesar", label: "Caesar" },
  { href: "/rot13", label: "ROT13" },
  { href: "/atbash", label: "Atbash" },
  { href: "/autokey", label: "Autokey" },
  { href: "/quagmire", label: "Quagmire" },
  { href: "/playfair", label: "Playfair" },
  { href: "/substitution", label: "Substitution" },
  { href: "/railfence", label: "Rail fence" },
  { href: "/transposition", label: "Transposition" },
  { href: "/polyalphabetic", label: "Polyalphabetic" },
  { href: "/analyze", label: "Identify" },
  { href: "/kryptos", label: "Kryptos" },
];
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ea580c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vigenere.org" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <title>{title}</title>
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${beaconToken}"}`}
        />
      )
    }
    {
      ads && adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body
    class="flex min-h-full flex-col bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100"
  >
    <header class="bg-orange-600 dark:bg-orange-700">
      <nav
        class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3"
      >
        <a href="/" class="font-bold tracking-tight text-white">vigenere.org</a>
        {
          tools.map((tool) => (
            <a
              href={tool.href}
              class="text-sm font-medium text-orange-100 hover:text-white"
            >
              {tool.label}
            </a>
          ))
        }
      </nav>
    </header>
    <noscript>
      <div
        class="mx-auto max-w-3xl px-4 py-3 text-sm text-slate-700 dark:text-slate-300"
      >
        The cipher tools on vigenere.org run entirely in your browser with
        JavaScript, so no ciphertext is ever sent to a server. Enable JavaScript
        to encrypt, decrypt, and break ciphers. Fetching a tool URL without a
        JavaScript engine (for example with curl) returns this page, not a
        computed result.
      </div>
    </noscript>
    <main class="mx-auto w-full max-w-3xl grow px-4 py-8">
      <slot />
    </main>
    <footer
      class="border-t border-orange-200 py-4 text-center text-sm text-slate-500 dark:border-orange-900 dark:text-slate-400"
    >
      <span
        >All ciphers run in your browser; your messages never leave the page.</span
      >
      <a
        href="/privacy"
        class="ml-2 underline-offset-2 hover:text-orange-700 hover:underline dark:hover:text-orange-400"
        >Privacy</a
      >
    </footer>
    <ClipboardButtons />
  </body>
</html>
